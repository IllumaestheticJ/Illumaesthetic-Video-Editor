[
 {"text":"[curious] Why are you spraying the windows white?","voice_type":"preset","voice_id":"2d51d9d0-b2a4-5e8b-9c63-f310adafd5f7"},
 {"text":"[matter-of-fact] The scanner shines a pattern of light on the car.","voice_type":"preset","voice_id":"573e5163-59b3-4926-aab1-951ef2985f81"},
 {"text":"A camera watches the lines bend.","voice_type":"preset","voice_id":"573e5163-59b3-4926-aab1-951ef2985f81"},
 {"text":"From that angle, it knows where every point is.","voice_type":"preset","voice_id":"573e5163-59b3-4926-aab1-951ef2985f81"},
 {"text":"[impatient] So what's wrong with windows?","voice_type":"preset","voice_id":"2d51d9d0-b2a4-5e8b-9c63-f310adafd5f7"},
 {"text":"[dry] Light goes straight through glass.","voice_type":"preset","voice_id":"573e5163-59b3-4926-aab1-951ef2985f81"},
 {"text":"Chrome's a mirror. It throws the light away.","voice_type":"preset","voice_id":"573e5163-59b3-4926-aab1-951ef2985f81"},
 {"text":"[slightly annoyed] And black just swallows it.","voice_type":"preset","voice_id":"573e5163-59b3-4926-aab1-951ef2985f81"},
 {"text":"[thinking] So you only spray the tricky bits?","voice_type":"preset","voice_id":"2d51d9d0-b2a4-5e8b-9c63-f310adafd5f7"},
 {"text":"[matter-of-fact] Glass. Chrome. Black. Badges. Now the light comes back.","voice_type":"preset","voice_id":"573e5163-59b3-4926-aab1-951ef2985f81"},
 {"text":"[curious] Why the squiggles?","voice_type":"preset","voice_id":"2d51d9d0-b2a4-5e8b-9c63-f310adafd5f7"},
 {"text":"[small sigh] Smooth panels all look the same. It needs something to track.","voice_type":"preset","voice_id":"573e5163-59b3-4926-aab1-951ef2985f81"},
 {"text":"[excited] Does it come off?","voice_type":"preset","voice_id":"2d51d9d0-b2a4-5e8b-9c63-f310adafd5f7"},
 {"text":"[deadpan] ...Depends on the spray.","voice_type":"preset","voice_id":"573e5163-59b3-4926-aab1-951ef2985f81"},
 {"text":"[excited] What do you spray with?","voice_type":"preset","voice_id":"2d51d9d0-b2a4-5e8b-9c63-f310adafd5f7"}
]
